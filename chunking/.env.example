# =====================================================================
# Google Cloud Document AI & GCS Configuration for Document Chunking
# =====================================================================

# Google Cloud Project ID
PROJECT_ID=your-gcp-project-id

# Document AI Processor Location ("us" or "eu")
LOCATION=us

# Document AI Layout Parser Processor ID
PROCESSOR_ID=your-processor-id

# Optional specific processor version (leave empty to use default version)
PROCESSOR_VERSION_ID=

# Google Cloud Storage Buckets (will be created automatically if they do not exist)
GCS_INPUT_BUCKET=your-input-bucket-name
GCS_OUTPUT_BUCKET=your-output-bucket-name

# Input document path: either local path (e.g. ./sample.pdf) or GCS URI (gs://bucket/path.pdf)
INPUT_FILE_PATH=./sample.pdf

# Chunking Configuration
CHUNK_SIZE=500
INCLUDE_ANCESTOR_HEADINGS=true

# Output directory for downloaded JSON results and manifest
LOCAL_OUTPUT_DIR=./results

# Path for generated HTML visualization dashboard
DASHBOARD_HTML_PATH=./results/dashboard.html
